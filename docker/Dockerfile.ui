FROM nginx:alpine

COPY ui/ /usr/share/nginx/html/

# OTP_API_BASE is read by the browser, not by nginx. Default is http://127.0.0.1:8000.
RUN cat > /docker-entrypoint.d/40-otp-config.sh << 'EOF'
#!/bin/sh
set -eu
BASE="${OTP_API_BASE:-http://127.0.0.1:8000}"
case "$BASE" in
  *\"*|*"'"*|*\ *|*\\*) BASE="http://127.0.0.1:8000" ;;
esac
printf 'window.OTP_API_BASE = "%s";\n' "$BASE" > /usr/share/nginx/html/config.js
EOF
RUN chmod +x /docker-entrypoint.d/40-otp-config.sh

EXPOSE 80
